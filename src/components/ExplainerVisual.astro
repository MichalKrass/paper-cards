---
import type { ExplainerVisual } from "../lib/explainers";

interface Props {
  visual: ExplainerVisual;
}

const { visual } = Astro.props;
---

<figure class={`explain-visual explain-visual--${visual.kind}`} aria-label={visual.title}>
  <figcaption>{visual.title}</figcaption>

  {visual.kind === "flow" && (
    <div class="visual-flow">
      {visual.items.map((item, index) => (
        <>
          <div class={`visual-node visual-tone--${item.tone ?? "neutral"}`}>
            <strong>{item.label}</strong>
            {item.value && <span>{item.value}</span>}
            {item.note && <small>{item.note}</small>}
          </div>
          {index < visual.items.length - 1 && <span class="visual-arrow" aria-hidden="true">→</span>}
        </>
      ))}
    </div>
  )}

  {visual.kind === "steps" && (
    <ol class="visual-steps">
      {visual.items.map((item, index) => (
        <li class={`visual-tone--${item.tone ?? "neutral"}`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div><strong>{item.label}</strong>{item.value && <b>{item.value}</b>}{item.note && <small>{item.note}</small>}</div>
        </li>
      ))}
    </ol>
  )}

  {visual.kind === "stats" && (
    <div class="visual-stats">
      {visual.items.map((item) => (
        <div class={`visual-tone--${item.tone ?? "neutral"}`}>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
          {item.note && <small>{item.note}</small>}
        </div>
      ))}
    </div>
  )}

  {visual.kind === "bars" && (
    <div class="visual-bars">
      {visual.items.map((item) => {
        const width = Math.max(2, Math.min(100, ((item.score ?? 0) / (item.max ?? 100)) * 100));
        return (
          <div class="visual-bar-row">
            <div><span>{item.label}</span><strong>{item.value ?? item.score}</strong></div>
            <span class="visual-bar-track" aria-hidden="true"><i class={`visual-tone--${item.tone ?? "accent"}`} style={`width:${width}%`}></i></span>
            {item.note && <small>{item.note}</small>}
          </div>
        );
      })}
    </div>
  )}

  {visual.kind === "compare" && (
    <div class="visual-compare">
      {visual.items.map((item, index) => (
        <div class={`visual-tone--${item.tone ?? (index === 0 ? "neutral" : "accent")}`}>
          <span>{index === 0 ? "BEFORE" : "AFTER"}</span>
          <strong>{item.label}</strong>
          {item.value && <b>{item.value}</b>}
          {item.note && <small>{item.note}</small>}
        </div>
      ))}
    </div>
  )}

  {visual.caption && <p class="visual-caption">{visual.caption}</p>}
</figure>
