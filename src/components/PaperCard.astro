---
import type { Paper } from "../lib/types";

interface Props {
  paper: Paper;
  index: number;
}

const { paper, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const statusLabel = paper.status === "verified" ? "已核验" : paper.status === "needs_review" ? "待复核" : "草稿";
const institutionLabel = paper.institutions?.length
  ? `${paper.institutions.slice(0, 2).join(" · ")}${paper.institutions.length > 2 ? " 等" : ""}`
  : "机构未确认";
const secondaryFields = paper.tags.filter((tag) => tag !== paper.task).slice(0, 2);
---

<a
  class="paper-card"
  data-paper-id={paper.id}
  data-paper-index={index}
  href={`${base}papers/${paper.id}/`}
  aria-label={`查看《${paper.title}》论文卡片`}
>
  <article>
    <div class="card-topline">
      <div class="card-fields" aria-label="论文标签">
        <span class="field-primary">{paper.task}</span>
        {secondaryFields.map((field) => <span>{field}</span>)}
      </div>
      <time datetime={paper.publicationDate}>{paper.publicationDate}</time>
    </div>

    <h2>{paper.title}</h2>
    {paper.titleZh && <p class="card-title-zh">{paper.titleZh}</p>}
    <p class="card-institution">{institutionLabel}</p>
    <p class="card-summary">{paper.oneLineSummary}</p>

    <div class="card-bottomline">
      {paper.status !== "verified" ? <span class={`review-note review-note--${paper.status}`}>{statusLabel}</span> : <span />}
      <span class="card-link-text">阅读论文卡片 <span aria-hidden="true">→</span></span>
    </div>
  </article>
</a>
