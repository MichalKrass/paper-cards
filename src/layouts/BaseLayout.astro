---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Paper Cards · 论文卡片库",
  description = "支持速览、结构化卡片与章节精读的个人论文知识库。",
  pageClass = "",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header" data-print-hide>
      <a class="brand" href={base} aria-label="Paper Cards 首页">
        <span class="brand-mark" aria-hidden="true">P</span>
        <span>
          <strong>Paper Cards</strong>
          <small>Research index</small>
        </span>
      </a>
      <p class="header-note">速览 · 卡片 · 精读</p>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer" data-print-hide>
      <p>数据与网站同仓库维护 · 每次更新均经过校验与构建</p>
      <p>Paper Cards / V2</p>
    </footer>
  </body>
</html>
