---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OriginalPaperAsset from "../../components/OriginalPaperAsset.astro";
import { papers } from "../../lib/data";
import { getPaperExplainer } from "../../lib/explainers";
import { getReadingNoteStatus } from "../../lib/reading-notes";
import type { Paper } from "../../lib/types";

export function getStaticPaths() {
  return papers.map((paper) => ({ params: { id: paper.id }, props: { paper } }));
}

interface Props {
  paper: Paper;
}

const { paper } = Astro.props;
const base = import.meta.env.BASE_URL;
const explainer = getPaperExplainer(paper.id);
const readingStatus = getReadingNoteStatus(paper.id);
const hasReadingNote = readingStatus !== "missing";
const evidenceLabel = {
  fulltext: "论文全文",
  abstract: "论文摘要",
  wechat_only: "公众号文章",
  mixed: "混合证据",
}[paper.evidenceLevel];
const statusLabel = paper.status === "verified" ? "已核验" : paper.status === "needs_review" ? "待复核" : "草稿";

const groups = [
  { id: "orientation", number: "01", eyebrow: "WHY IT MATTERS", title: "先把问题看懂", description: "它是谁、解决什么、适合用在哪里。", dimensions: explainer.dimensions.slice(0, 7) },
  { id: "mechanism", number: "02", eyebrow: "HOW IT WORKS", title: "方法为什么有效", description: "把结构、训练、数据和结果连成一条因果链。", dimensions: explainer.dimensions.slice(7, 14) },
  { id: "delivery", number: "03", eyebrow: "CAN WE USE IT", title: "工程与价值判断", description: "看开源、复现、算力以及是否值得进入真实系统。", dimensions: explainer.dimensions.slice(14, 20) },
  { id: "boundaries", number: "04", eyebrow: "WHERE IT BREAKS", title: "边界与下一步", description: "明确不能做什么，以及下一轮该验证什么。", dimensions: explainer.dimensions.slice(20, 22) },
];
---

<BaseLayout title={`${paper.titleZh ?? paper.title} · 深度论文卡片 · Paper Cards`} description={paper.oneLineSummary} pageClass="paper-card-page">
  <article class="card-detail">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href={base}>论文库</a>
      <span aria-hidden="true">/</span>
      <span>论文卡片</span>
    </nav>

    <header class="card-detail-hero">
      <div class="card-detail-kicker">
        <span>{paper.task}</span>
        <time datetime={paper.publicationDate}>{paper.publicationDate}</time>
        <span>{explainer.readingMinutes} 分钟读完</span>
      </div>
      <p class="card-detail-label">VISUAL PAPER EXPLAINER · 22 DIMENSIONS</p>
      <h1>{paper.title}</h1>
      {paper.titleZh && <p class="card-detail-title-zh">{paper.titleZh}</p>}
      <p class="card-detail-summary">{paper.oneLineSummary}</p>

      <div class="card-detail-byline">
        <p><strong>机构</strong>{paper.institutions?.join("、") || "未确认"}</p>
        <p><strong>作者</strong>{paper.authors.join("、")}</p>
      </div>

      <div class="card-detail-actions">
        {hasReadingNote ? (
          <a class="primary-action" href={`${base}papers/${paper.id}/reading/`}>进入章节精读 <span aria-hidden="true">→</span></a>
        ) : (
          <span class="unavailable-action" aria-disabled="true">章节精读尚未生成</span>
        )}
        {paper.paperUrl && <a class="secondary-action" href={paper.paperUrl} target="_blank" rel="noreferrer">打开原论文 ↗</a>}
      </div>
    </header>

    <section class="takeaway-panel" aria-labelledby="takeaway-title">
      <div class="takeaway-heading">
        <p>READ THIS FIRST</p>
        <h2 id="takeaway-title">先记住这三点</h2>
        <span>依据 {explainer.sourceVersion} · {evidenceLabel}</span>
      </div>
      <ol>
        {explainer.takeaways.map((takeaway, index) => <li><span>{index + 1}</span><p>{takeaway}</p></li>)}
      </ol>
    </section>

    <nav class="card-section-nav" aria-label="论文卡片分组">
      {groups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
    </nav>

    <div class="explain-groups">
      {groups.map((group) => (
        <section id={group.id} class="explain-group">
          <header class="explain-group-heading">
            <span>{group.number}</span>
            <div>
              <p>{group.eyebrow}</p>
              <h2>{group.title}</h2>
              <small>{group.description}</small>
            </div>
          </header>

          <div class="explain-grid">
            {group.dimensions.map((dimension) => (
              <article
                class:list={["explain-card", dimension.visual && "explain-card--visual", [1, 2, 3].includes(dimension.id) && "explain-card--compact"]}
                data-dimension-id={dimension.id}
              >
                <header>
                  <span>{String(dimension.id).padStart(2, "0")}</span>
                  <h3>{dimension.label}</h3>
                </header>
                <p class="explain-summary">{dimension.summary}</p>
                <ul class="explain-points">
                  {dimension.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
                {dimension.visual && <OriginalPaperAsset asset={dimension.visual} paperUrl={paper.paperUrl} />}
                {dimension.id === 15 && paper.codeUrl && <a class="explain-inline-link" href={paper.codeUrl} target="_blank" rel="noreferrer">打开官方代码仓库 ↗</a>}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section class="card-provenance" aria-labelledby="provenance-title">
      <div>
        <p class="card-detail-label">SOURCES & TRUST</p>
        <h2 id="provenance-title">来源与可信度</h2>
        <p>本卡片按 {explainer.sourceVersion} 的 {explainer.sourceSections.join("、")} 展开，基于{evidenceLabel}整理，状态为{statusLabel}。最后更新于 {paper.updatedAt.slice(0, 10)}。</p>
      </div>
      <ul>
        {paper.sources.map((source) => <li><span>{source.kind}</span><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}
      </ul>
    </section>
  </article>
</BaseLayout>
