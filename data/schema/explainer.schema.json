{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paper-cards.local/schema/explainer.schema.json",
  "title": "Paper explainer",
  "type": "object",
  "additionalProperties": false,
  "required": ["paperId", "readingMinutes", "sourceVersion", "sourceSections", "takeaways", "dimensions"],
  "properties": {
    "paperId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "readingMinutes": { "type": "integer", "minimum": 3, "maximum": 30 },
    "sourceVersion": { "type": "string", "minLength": 2 },
    "sourceSections": { "$ref": "#/definitions/stringList" },
    "takeaways": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 8 }
    },
    "dimensions": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "summary", "bullets"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 22 },
          "label": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 8 },
          "bullets": { "$ref": "#/definitions/stringList" },
          "visual": { "$ref": "#/definitions/visual" }
        }
      }
    }
  },
  "definitions": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "src", "label", "pdfPage", "alt", "caption", "explanation"],
      "properties": {
        "kind": { "enum": ["figure", "table", "equation", "excerpt"] },
        "src": { "type": "string", "pattern": "^papers/[a-z0-9._-]+/original/[a-z0-9._-]+\\.webp$" },
        "label": { "type": "string", "minLength": 4 },
        "pdfPage": { "type": "integer", "minimum": 1 },
        "alt": { "type": "string", "minLength": 8 },
        "caption": { "type": "string", "minLength": 8 },
        "explanation": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 8 },
          "uniqueItems": true
        }
      }
    }
  }
}
